set -euo pipefail

slurm_command="$(basename "$0")"
budget_file="/fsx/references/runtime_assets/budget_tags/pcluster-project-budget-tags.tsv"
cluster_config="/opt/parallelcluster/shared/cluster-config.yaml"
budget_monitor_base_url="https://ursa.day.lsmc.bio/ursa-actions#budgets?budget="
rnd_budget_project="RnD"

project=""
declare -a passthrough_args=()

budget_url() {
    python3 -c 'from urllib.parse import quote; import sys; print(quote(sys.argv[1], safe=""))' "$1"
}

monitor_url() {
    printf "%s%s" "${budget_monitor_base_url}" "$(budget_url "$1")"
}

fail() {
    local message="$1"
    local project_arg="${2:-${project:-}}"
    echo "ERROR: ${message}" >&2
    if [ -n "${project_arg}" ]; then
        echo "Budget project: ${project_arg}" >&2
        echo "Budget monitor: $(monitor_url "${project_arg}")" >&2
    fi
    exit 1
}

info() {
    echo "Budget enforcement: $*" >&2
}

strip_exclusive() {
    local argument="$1"
    echo "ALERT WARNING: DYEC sbatch stripped exclusive allocation request '${argument}'. Exclusive Slurm allocation is disabled globally; request CPU and memory resources explicitly instead." >&2
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --comment)
            if [ -n "${project}" ]; then
                fail "multiple --comment values are not allowed"
            fi
            shift
            if [ "$#" -eq 0 ] || [ -z "${1:-}" ]; then
                fail "--comment requires a project/budget value"
            fi
            project="$1"
            ;;
        --comment=*)
            if [ -n "${project}" ]; then
                fail "multiple --comment values are not allowed"
            fi
            project="${1#--comment=}"
            if [ -z "${project}" ]; then
                fail "--comment requires a project/budget value"
            fi
            ;;
        --exclusive|--exclusive=*)
            strip_exclusive "$1"
            ;;
        *)
            passthrough_args+=("$1")
            ;;
    esac
    shift
done

if [ -z "${project}" ]; then
    echo "ERROR: Please specify a project/budget name with --comment <ProjectName>." >&2
    echo "Available budget projects are listed in ${budget_file} when the reference FSx import is mounted." >&2
    exit 1
fi

if [[ "${project}" =~ [[:space:]] ]]; then
    fail "--comment project must not contain whitespace" "${project}"
fi

if [ "${project}" = "${rnd_budget_project}" ]; then
    info "project '${rnd_budget_project}' uses the exact RnD bypass; AWS budget lookup skipped."
    exec "/opt/slurm/sbin/${slurm_command}" --comment="${project}" --export=ALL "${passthrough_args[@]}"
fi

if [ ! -f "${cluster_config}" ]; then
    fail "cluster config not found at ${cluster_config}" "${project}"
fi

enforce_budget="$(
    awk '/Key: aws-parallelcluster-enforce-budget/ {getline; print $2; exit}' "${cluster_config}" |
        sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
)"

case "${enforce_budget}" in
    skip|false|False|0|no|No)
        info "budget check skipped by cluster config '${enforce_budget}' for project '${project}'."
        exec "/opt/slurm/sbin/${slurm_command}" --comment="${project}" --export=ALL "${passthrough_args[@]}"
        ;;
    true|True|1|yes|Yes|enforce|enforced)
        ;;
    "")
        fail "aws-parallelcluster-enforce-budget tag is missing from ${cluster_config}" "${project}"
        ;;
    *)
        fail "unknown aws-parallelcluster-enforce-budget value '${enforce_budget}'" "${project}"
        ;;
esac

if [ ! -f "${budget_file}" ]; then
    fail "budget allow-list file not found at ${budget_file}" "${project}"
fi

current_user="${USER:-$(id -un 2>/dev/null || true)}"
if [ -z "${current_user}" ]; then
    fail "USER is not set and id -un failed; cannot validate budget project membership" "${project}"
fi

project_users="$(awk -F'\t' -v proj="${project}" '$1 == proj && NF == 2 {print $2}' "${budget_file}" | tr ',' '\n')"
if [ -z "${project_users}" ]; then
    echo "Available budgets/projects:" >&2
    cat "${budget_file}" >&2
    fail "project '${project}' was not found in ${budget_file}" "${project}"
fi

if ! echo "${project_users}" | grep -qx "${current_user}"; then
    fail "user '${current_user}' is not authorized for project '${project}'" "${project}"
fi

region="$(
    awk -F'=' '$1 == "cfn_region" {print $2; exit}' /etc/parallelcluster/cfnconfig 2>/dev/null ||
        true
)"
if [ -z "${region}" ]; then
    fail "region is not set in /etc/parallelcluster/cfnconfig; cannot verify budget" "${project}"
fi

AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query "Account" --output text 2>/dev/null || true)"
if [ -z "${AWS_ACCOUNT_ID}" ] || [ "${AWS_ACCOUNT_ID}" = "None" ]; then
    fail "unable to resolve AWS account id with sts get-caller-identity" "${project}"
fi

budget_values="$(
    aws budgets describe-budget \
        --account-id "${AWS_ACCOUNT_ID}" \
        --budget-name "${project}" \
        --region "${region}" \
        --query 'Budget.[BudgetLimit.Amount,CalculatedSpend.ActualSpend.Amount,BudgetLimit.Unit]' \
        --output text 2>&1
)" || fail "no readable AWS Budget named '${project}' in account ${AWS_ACCOUNT_ID}: ${budget_values}" "${project}"

read -r total_budget used_budget budget_unit _extra <<< "${budget_values}"
if [ -z "${total_budget:-}" ] || [ -z "${used_budget:-}" ] || [ "${total_budget}" = "None" ] || [ "${used_budget}" = "None" ]; then
    fail "AWS Budget '${project}' did not include BudgetLimit.Amount and CalculatedSpend.ActualSpend.Amount" "${project}"
fi

if ! awk -v total="${total_budget}" -v used="${used_budget}" 'BEGIN { exit !((total + 0) > 0 && used >= 0) }'; then
    fail "AWS Budget '${project}' has invalid numeric values total='${total_budget}' used='${used_budget}'" "${project}"
fi

percent_used="$(awk -v total="${total_budget}" -v used="${used_budget}" 'BEGIN { printf "%.2f", (used / total) * 100 }')"

info "project '${project}' in region '${region}': total=${total_budget} ${budget_unit:-USD}, used=${used_budget} ${budget_unit:-USD}, percent=${percent_used}%."
info "budget monitor: $(monitor_url "${project}")"

if awk -v percent="${percent_used}" 'BEGIN { exit !(percent >= 100) }'; then
    fail "AWS Budget '${project}' is exhausted: ${percent_used}% used (${used_budget}/${total_budget} ${budget_unit:-USD})" "${project}"
fi

exec "/opt/slurm/sbin/${slurm_command}" --comment="${project}" --export=ALL "${passthrough_args[@]}"
