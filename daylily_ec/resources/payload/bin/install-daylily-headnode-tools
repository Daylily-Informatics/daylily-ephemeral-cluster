#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: install-daylily-headnode-tools [-h|--help]

Installs a small set of Daylily helper assets on a ParallelCluster head node:
  - Copies daylily CLI config files into ~/.config/daylily
  - Installs `day-clone`, `sq`, and `sqq` helpers into ~/.local/bin
  - Writes a managed bootstrap file that loads the DAY-EC shell context for fresh login shells

This script is safe to run from any working directory as long as the
daylily-ephemeral-cluster package is installed (or DAYLILY_EC_RESOURCES_DIR is set).
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

resolve_daylily_res_dir() {
    if [[ -n "${DAYLILY_EC_RESOURCES_DIR:-}" ]]; then
        echo "${DAYLILY_EC_RESOURCES_DIR}"
        return 0
    fi
    local script_dir repo_root
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo_root="$(cd "${script_dir}/.." && pwd)"
    if [[ -d "${repo_root}/config" && -d "${repo_root}/bin" ]]; then
        echo "${repo_root}"
        return 0
    fi
    if command -v daylily-ec >/dev/null 2>&1; then
        daylily-ec resources-dir
        return 0
    fi
    echo "Error: could not resolve Daylily resources dir. Set DAYLILY_EC_RESOURCES_DIR or install daylily-ephemeral-cluster." >&2
    return 1
}

write_login_bootstrap() {
    local bootstrap_file="$1"

    cat >"$bootstrap_file" <<'EOF'
# Managed by install-daylily-headnode-tools. Source this file from shell startup.
repo_root="$HOME/projects/daylily-ephemeral-cluster"
activate_script="$repo_root/activate"
user_bin_dir="$HOME/.local/bin"
global_config="$HOME/.config/daylily/daylily_cli_global.yaml"

stty -ixon -ixoff 2>/dev/null || true

case ":$PATH:" in
    *":${user_bin_dir}:"*) ;;
    *) export PATH="${user_bin_dir}:$PATH" ;;
esac

if [[ "${DAYLILY_EC_HEADNODE_BOOTSTRAPPED:-0}" != "1" || "${CONDA_DEFAULT_ENV:-}" != "DAY-EC" ]]; then
    if [[ ! -f "$activate_script" ]]; then
        echo "Error: missing Daylily activate script at $activate_script" >&2
        return 1
    fi

    # shellcheck source=/dev/null
    source "$activate_script"

    if [[ "${CONDA_DEFAULT_ENV:-}" != "DAY-EC" ]]; then
        conda activate DAY-EC >/dev/null 2>&1 || {
            echo "Error: failed to activate DAY-EC after sourcing $activate_script" >&2
            return 1
        }
    fi

    if ! command -v daylily-ec >/dev/null 2>&1; then
        echo "Error: daylily-ec is not available after sourcing $activate_script" >&2
        return 1
    fi

    eval "$(daylily-ec headnode init --emit-shell --non-interactive --skip-project-check)"
    DAYLILY_EC_HEADNODE_BOOTSTRAPPED=1
fi

sentieon_license_endpoint="$(python3 - "$global_config" <<'PY'
from pathlib import Path
import sys

import yaml

path = Path(sys.argv[1])
expected_endpoint = "license.sentieon.lsmc.bio:8990"
if not path.is_file():
    raise SystemExit(f"Error: missing Daylily global config: {path}")
payload = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
daylily = payload.get("daylily") or {}
if "sentieon_lic_path" in daylily:
    raise SystemExit(
        f"Error: legacy daylily.sentieon_lic_path is forbidden in {path}; "
        "configure daylily.sentieon_license instead"
    )
license_config = daylily.get("sentieon_license")
if not isinstance(license_config, dict):
    raise SystemExit(f"Error: daylily.sentieon_license must be a mapping in {path}")
if license_config.get("mode") != "server":
    raise SystemExit(f"Error: daylily.sentieon_license.mode must be server in {path}")
endpoint = str(license_config.get("endpoint") or "").strip()
if endpoint != expected_endpoint:
    raise SystemExit(
        f"Error: daylily.sentieon_license.endpoint must be {expected_endpoint} in {path}"
    )
print(endpoint)
PY
)" || return 1
export SENTIEON_LICENSE="$sentieon_license_endpoint"

unset repo_root activate_script user_bin_dir global_config sentieon_license_endpoint
EOF
    chmod 0644 "$bootstrap_file"
}

install_managed_login_block() {
    local target_file="$1"
    local bootstrap_file="$2"

    mkdir -p "$(dirname "$target_file")"
    touch "$target_file"

    python3 - "$target_file" "$bootstrap_file" <<'PY'
from pathlib import Path
import shlex
import sys

target = Path(sys.argv[1])
bootstrap = sys.argv[2]
start = "# >>> daylily headnode bootstrap >>>"
end = "# <<< daylily headnode bootstrap <<<"
text = target.read_text(encoding="utf-8")
parts = []
cursor = 0

while True:
    start_idx = text.find(start, cursor)
    if start_idx == -1:
        parts.append(text[cursor:])
        break
    parts.append(text[cursor:start_idx])
    end_idx = text.find(end, start_idx)
    if end_idx == -1:
        cursor = len(text)
        break
    cursor = end_idx + len(end)
    if cursor < len(text) and text[cursor] == "\n":
        cursor += 1

cleaned = "".join(parts).rstrip()
block = "\n".join(
    [
        "# >>> daylily headnode bootstrap >>>",
        f"if [[ -f {shlex.quote(bootstrap)} ]]; then",
        f"    . {shlex.quote(bootstrap)}",
        "fi",
        "# <<< daylily headnode bootstrap <<<",
    ]
)

if cleaned:
    rendered = cleaned + "\n\n" + block + "\n"
else:
    rendered = block + "\n"

target.write_text(rendered, encoding="utf-8")
PY
}

ensure_python_yaml() {
    if python3 - <<'PY' >/dev/null 2>&1
import yaml
PY
    then
        return 0
    fi
    python3 -m pip install --user PyYAML
    python3 - <<'PY' >/dev/null
import yaml
PY
}

validate_sentieon_license_config() {
    local config_path="$1"
    python3 - "$config_path" <<'PY'
from pathlib import Path
import sys

import yaml

path = Path(sys.argv[1])
expected_endpoint = "license.sentieon.lsmc.bio:8990"
payload = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
daylily = payload.get("daylily") or {}
if "sentieon_lic_path" in daylily:
    raise SystemExit(
        f"Error: legacy daylily.sentieon_lic_path is forbidden in {path}; "
        "configure daylily.sentieon_license instead"
    )
license_config = daylily.get("sentieon_license")
if not isinstance(license_config, dict):
    raise SystemExit(f"Error: daylily.sentieon_license must be a mapping in {path}")
if license_config.get("mode") != "server":
    raise SystemExit(f"Error: daylily.sentieon_license.mode must be server in {path}")
endpoint = str(license_config.get("endpoint") or "").strip()
if endpoint != expected_endpoint:
    raise SystemExit(
        f"Error: daylily.sentieon_license.endpoint must be {expected_endpoint} in {path}"
    )
PY
}

REPO_ROOT="$(resolve_daylily_res_dir)" || exit 1
CONFIG_SOURCE_DIR="$REPO_ROOT/config"
TARGET_CONFIG_DIR="$HOME/.config/daylily"
BOOTSTRAP_FILE="$TARGET_CONFIG_DIR/daylily-headnode-bootstrap.sh"
USER_BIN_DIR="$HOME/.local/bin"
CLUSTER_CONFIG_PATH="${DAYLILY_EC_CLUSTER_CONFIG_PATH:-/opt/parallelcluster/shared/cluster-config.yaml}"

mkdir -p "$TARGET_CONFIG_DIR" "$USER_BIN_DIR"

ensure_python_yaml

cp "$CONFIG_SOURCE_DIR/daylily_cli_global.yaml" "$TARGET_CONFIG_DIR/daylily_cli_global.yaml"
validate_sentieon_license_config "$TARGET_CONFIG_DIR/daylily_cli_global.yaml"
cp "$CONFIG_SOURCE_DIR/daylily_pipeline_command_catalog.yaml" "$TARGET_CONFIG_DIR/daylily_pipeline_command_catalog.yaml"
install -m 0644 "$CONFIG_SOURCE_DIR/github_known_hosts" "$TARGET_CONFIG_DIR/github_known_hosts"
ln -sfn daylily_pipeline_command_catalog.yaml "$TARGET_CONFIG_DIR/daylily_available_repositories.yaml"

install -m 0755 "$REPO_ROOT/bin/headnode_utils/day-clone" "$USER_BIN_DIR/day-clone"
echo "day-clone installed to $USER_BIN_DIR/day-clone"
install -m 0755 "$REPO_ROOT/bin/headnode_utils/sqq" "$USER_BIN_DIR/sqq"
install -m 0755 "$REPO_ROOT/bin/headnode_utils/sq" "$USER_BIN_DIR/sq"
echo "sq and sqq installed to $USER_BIN_DIR"

cd "$REPO_ROOT"
"$REPO_ROOT/bin/install_miniconda"

write_login_bootstrap "$BOOTSTRAP_FILE"
install_managed_login_block "$HOME/.bashrc" "$BOOTSTRAP_FILE"
install_managed_login_block "$HOME/.bash_profile" "$BOOTSTRAP_FILE"

reference_storage_bucket_name="$(grep -m1 -oE 's3://[^[:space:]]+' "$CLUSTER_CONFIG_PATH" | sed -E 's#^s3://([^/]+).*$#\1#')"
if [[ -z "$reference_storage_bucket_name" ]]; then
    echo "Error: could not determine reference storage from $CLUSTER_CONFIG_PATH" >&2
    exit 1
fi
reference_s3_uri="s3://${reference_storage_bucket_name}"
python3 - "$REPO_ROOT/etc/analysis_samples_template.tsv" "$reference_s3_uri" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
reference_s3_uri = sys.argv[2]
text = path.read_text(encoding="utf-8")
path.write_text(text.replace("<REF-S3-URI>", reference_s3_uri), encoding="utf-8")
PY

source "$BOOTSTRAP_FILE"
