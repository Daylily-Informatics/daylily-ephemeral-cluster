+def test_truvari_not_applicable_is_a_warning_without_metrics(tmp_path: Path) -> None:
+    query = _vcf(tmp_path / "na23687.vcf.gz", sample="NA23687")
+    truth = _vcf(tmp_path / "hg002-truth.vcf.gz", sample="HG002")
+    receipt = tmp_path / "terminal_receipt.json"
+    payload = nicu.write_truvari_not_applicable(
+        Namespace(
+            receipt=str(receipt),
+            query_name="nicu_jasmine",
+            query_sample="NA23687",
+            truth_sample="HG002",
+            expected_analysis_unit="HG002-analysis-unit",
+            query_vcf=str(query),
+            truth_vcf=str(truth),
+        )
+    )
+    assert payload == json.loads(receipt.read_text(encoding="utf-8"))
+    assert payload["schema"] == nicu.TRUVARI_NOT_APPLICABLE_RECEIPT_SCHEMA
+    assert payload["status"] == "DIAGNOSTIC_FAILED"
+    assert payload["metrics"] == {}
+    assert payload["attempted_command"] == []
+    assert payload["applicability"] == {
+        "applicable": False,
+        "reason_code": "GIAB_SV_V5Q_HG002_ONLY",
+        "eligible_analysis_unit": "HG002-analysis-unit",
+        "query_analysis_unit": "NA23687",
+    }
+    assert payload["query_vcf_sha256"] == nicu._sha256(query)
+    assert payload["truth_vcf_sha256"] == nicu._sha256(truth)
+    assert "No Truvari comparison was attempted" in payload["error"]
+
+    summary = tmp_path / "summary.tsv"
+    metrics = tmp_path / "metrics.json"
+    assert (
+        nicu.extract_truvari(
+            Namespace(
+                receipt=str(receipt),
+                summary_tsv=str(summary),
+                metrics_json=str(metrics),
+                allow_diagnostic_warning=True,
+            )
+        )
+        == "WARNING"
+    )
+    warning_metrics = json.loads(metrics.read_text(encoding="utf-8"))
+    assert warning_metrics["status"] == "WARNING"
+    assert warning_metrics["metrics"] == {}
+    assert warning_metrics["warning"]["receipt_status"] == "DIAGNOSTIC_FAILED"
+    assert warning_metrics["warning"]["attempted_command"] == []
+    assert "\t\t\t\t\t\t\tWARNING\tNOT_APPLICABLE:" in (
+        summary.read_text(encoding="utf-8")
+    )
+
+    with pytest.raises(nicu.Hiomr2NicuSvError, match="cannot be marked"):
+        nicu.write_truvari_not_applicable(
+            Namespace(
+                receipt=str(tmp_path / "invalid.json"),
+                query_name="nicu_jasmine",
+                query_sample="HG002-analysis-unit",
+                truth_sample="HG002",
+                expected_analysis_unit="HG002-analysis-unit",
+                query_vcf=str(query),
+                truth_vcf=str(truth),
+            )
+        )
