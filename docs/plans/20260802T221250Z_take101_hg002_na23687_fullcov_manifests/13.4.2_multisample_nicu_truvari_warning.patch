+def write_truvari_not_applicable(args: argparse.Namespace) -> dict[str, Any]:
+    """Publish a truthful terminal receipt when HG002 truth is inapplicable."""
+
+    query_name = str(args.query_name)
+    query_sample = str(args.query_sample)
+    truth_sample = str(args.truth_sample)
+    expected_analysis_unit = str(args.expected_analysis_unit)
+    for description, value in (
+        ("query name", query_name),
+        ("query sample", query_sample),
+        ("truth sample", truth_sample),
+        ("expected analysis unit", expected_analysis_unit),
+    ):
+        if SAFE_SAMPLE_RE.fullmatch(value) is None:
+            raise Hiomr2NicuSvError(f"invalid {description}: {value!r}")
+    if query_sample == expected_analysis_unit:
+        raise Hiomr2NicuSvError(
+            "the HG002 truth-matched analysis unit cannot be marked not applicable"
+        )
+    query_vcf = _regular(Path(args.query_vcf), "NICU Truvari query VCF")
+    truth_vcf = _regular(Path(args.truth_vcf), "GIAB SV v5.0q truth VCF")
+    error = (
+        "NOT_APPLICABLE: GIAB SV v5.0q NICU truth is valid only for analysis "
+        f"unit {expected_analysis_unit}; query analysis unit {query_sample} was "
+        "not benchmarked. No Truvari comparison was attempted and no benchmark "
+        "metrics were emitted."
+    )
+    payload = {
+        "schema": TRUVARI_NOT_APPLICABLE_RECEIPT_SCHEMA,
+        "query_name": query_name,
+        "query_sample": query_sample,
+        "truth_sample": truth_sample,
+        "status": "DIAGNOSTIC_FAILED",
+        "error": error,
+        "exit_code": None,
+        "attempted_command": [],
+        "metrics": {},
+        "projection": None,
+        "query_vcf_sha256": _sha256(query_vcf),
+        "truth_vcf_sha256": _sha256(truth_vcf),
+        "applicability": {
+            "applicable": False,
+            "reason_code": "GIAB_SV_V5Q_HG002_ONLY",
+            "eligible_analysis_unit": expected_analysis_unit,
+            "query_analysis_unit": query_sample,
+        },
+    }
+    _atomic_json(Path(args.receipt), payload)
+    return payload
+
+
